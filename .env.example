# Домен, на котором будет жить Lupa (A-запись должна указывать на этот сервер)
LUPA_DOMAIN=stats.example.ru
# Почта для сертификата Let's Encrypt
ACME_EMAIL=admin@example.ru
# Пароль ClickHouse, любой длинный
CLICKHOUSE_PASSWORD=change-me-to-a-long-random-string
# Домен сайта продукта (статика из каталога site/), необязательно
SITE_DOMAIN=
# Домен публичного демо (второй инстанс, docker-compose.demo.yml), необязательно
DEMO_DOMAIN=
# Часовой пояс отчётов
LUPA_TZ=Europe/Moscow
# Реестр образов. Если Docker Hub недоступен, укажите зеркало: mirror.gcr.io или dockerhub.timeweb.cloud
REGISTRY=mirror.gcr.io
