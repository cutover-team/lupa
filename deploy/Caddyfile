{
  email {$ACME_EMAIL}
  # Только Let's Encrypt: ZeroSSL из России отвечает ошибкой и тратит попытки
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# Панель и счётчик Lupa
{$LUPA_DOMAIN} {
  encode zstd gzip
  reverse_proxy lupa:8080
}

# Сайт продукта: статика из каталога site/
{$SITE_DOMAIN:localhost:8082} {
  root * /srv/site
  encode zstd gzip
  file_server
}

# www -> без www
www.{$SITE_DOMAIN:localhost} {
  redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}

# Публичное демо
{$DEMO_DOMAIN:localhost:8083} {
  encode zstd gzip
  reverse_proxy lupa-demo:8080
}
